# Copy to a protected location such as C:\Spect8\config\spect8.production.env.
# Never commit the populated file.
SPECT8_APPLICATION_ENVIRONMENT=production
SPECT8_APPLICATION_VERSION=replace-with-deployed-git-commit

SPECT8_DATABASE_PATH=C:\Spect8\data\spect8.db
SPECT8_HISTORICAL_REPLAY_DATABASE_PATH=C:\Spect8\data\spect8-historical-replay.db
SPECT8_MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=replace-with-server-side-provider-key
SPECT8_AUTO_SEED_SYNTHETIC=false

# Stage 1 safe copied-data mode.
SPECT8_POLLING_ENABLED=false
SPECT8_STARTUP_BACKFILL_ENABLED=false
SPECT8_PROVIDER_DISCOVERY_ENABLED=false
SPECT8_MARKET_DATA_RUNTIME_ENABLED=false
SPECT8_MARKET_SCAN_ENABLED=false

BACKEND_URL=http://127.0.0.1:8000
DASHBOARD_ORIGIN=https://spect8dashboard.digitallabb.com
SPECT8_INTERNAL_API_KEY=replace-with-one-long-random-server-side-key
DASHBOARD_PASSWORD_HASH=scrypt:16384:8:1:replace-salt:replace-derived-key
SESSION_SECRET=replace-with-at-least-32-random-characters
