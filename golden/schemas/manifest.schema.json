{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spect8.local/schemas/manifest.schema.json",
  "title": "GoldenCaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_id",
    "authority",
    "dataset_version",
    "description",
    "cases"
  ],
  "properties": {
    "strategy_id": {
      "const": "SPECT8_MICRO_DAILY_V1_0"
    },
    "authority": {
      "const": "../Spect8_Micro_Daily_v1_0_3_FROZEN.md"
    },
    "dataset_version": {
      "const": "1.0.3"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "timeframe",
          "evaluation_time",
          "description",
          "coverage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^cases/[a-z0-9_]+$"
          },
          "timeframe": {
            "enum": ["H1", "H4"]
          },
          "evaluation_time": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "independence_group": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
