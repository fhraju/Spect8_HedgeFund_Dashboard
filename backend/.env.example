SPECT8_DATABASE_PATH=var/spect8_phase1.sqlite3
SPECT8_INTERNAL_API_KEY=replace-with-a-long-random-internal-key
SPECT8_AUTO_SEED_SYNTHETIC=true
TWELVE_DATA_API_KEY=
SPECT8_MARKET_DATA_PROVIDER=replay
SPECT8_MARKET_DATA_RUNTIME_ENABLED=false
SPECT8_MARKET_DATA_POLL_SECONDS=300
SPECT8_MARKET_DATA_SAFETY_DELAY_SECONDS=30
SPECT8_RUNTIME_LOG_PATH=var/spect8_runtime.log
SPECT8_RUNTIME_LOG_MAX_BYTES=5000000
SPECT8_RUNTIME_LOG_BACKUP_COUNT=5
