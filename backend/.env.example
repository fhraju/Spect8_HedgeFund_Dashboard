SPECT8_DATABASE_PATH=var/spect8_phase1.sqlite3
SPECT8_INTERNAL_API_KEY=replace-with-a-long-random-internal-key
SPECT8_AUTO_SEED_SYNTHETIC=true
TWELVE_DATA_API_KEY=
SPECT8_MARKET_DATA_PROVIDER=replay
SPECT8_MARKET_DATA_RUNTIME_ENABLED=false
SPECT8_MARKET_SCAN_ENABLED=false
SPECT8_MARKET_SCAN_AFTER_HOUR_SECONDS=60
SPECT8_MARKET_DATA_REQUEST_MIN_INTERVAL_SECONDS=8
SPECT8_MARKET_DATA_MAX_REQUESTS_PER_MINUTE=8
TWELVE_DATA_DAILY_CREDIT_LIMIT=800
MARKET_DATA_DAILY_OPERATIONAL_BUDGET=700
MARKET_DATA_CREDIT_RESERVE=100
SPECT8_MARKET_DATA_MAX_RETRIES_PER_INSTRUMENT=2
SPECT8_MARKET_DATA_STALE_AFTER_SECONDS=7200
# Optional subset in canonical registry order. Omit to enable the 24
# live-validated defaults. TLT and the earlier direct-market candidates stay
# disabled unless a later controlled validation changes their registry status.
SPECT8_MARKET_DATA_POLL_SECONDS=300
SPECT8_MARKET_DATA_SAFETY_DELAY_SECONDS=30
SPECT8_RUNTIME_LOG_PATH=var/spect8_runtime.log
SPECT8_RUNTIME_LOG_MAX_BYTES=5000000
SPECT8_RUNTIME_LOG_BACKUP_COUNT=5
SPECT8_HISTORICAL_REPLAY_DATABASE_PATH=var/spect8_historical_replay.sqlite3
